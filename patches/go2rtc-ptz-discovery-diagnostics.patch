+func classifyDiscoveryPacket(packet []byte) string {
+	cc51Magic := len(packet) >= 2 && string(packet[:2]) == magicCC51
+	if cc51Magic {
+		command := "unavailable"
+		payloadLength := "unavailable"
+		directionStatus := "unavailable"
+		if len(packet) >= 6 {
+			command = fmt.Sprintf("0x%04x", binary.LittleEndian.Uint16(packet[4:6]))
+		}
+		if len(packet) >= 8 {
+			payloadLength = fmt.Sprintf("%d", binary.LittleEndian.Uint16(packet[6:8]))
+		}
+		if len(packet) >= 10 {
+			directionStatus = fmt.Sprintf("0x%04x", binary.LittleEndian.Uint16(packet[8:10]))
+		}
+		classification := "CC51-like short packet"
+		if len(packet) >= packetSizeCC51 {
+			classification = "CC51 packet"
+		}
+		return fmt.Sprintf("packet_len=%d cc51_magic=true command=%s declared_payload_len=%s direction_status=%s classification=%s",
+			len(packet), command, payloadLength, directionStatus, classification)
+	}
+
+	decoded := tutk.ReverseTransCodeBlob(packet)
+	if len(decoded) >= 16 {
+		return fmt.Sprintf("packet_len=%d cc51_magic=false classification=IOTC command=0x%04x",
+			len(packet), binary.LittleEndian.Uint16(decoded[8:]))
+	}
+	return fmt.Sprintf("packet_len=%d cc51_magic=false classification=unrecognized", len(packet))
+}

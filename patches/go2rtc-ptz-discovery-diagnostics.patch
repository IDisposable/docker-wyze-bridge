--- /dev/null
+++ b/pkg/tutk/dtls/discovery_diagnostics_test.go
@@ -0,0 +1,59 @@
+package dtls
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/tutk"
+)
+
+func TestClassifyDiscoveryPacket(t *testing.T) {
+	cc51 := make([]byte, packetSizeCC51)
+	copy(cc51, magicCC51)
+	binary.LittleEndian.PutUint16(cc51[4:], cmdDiscoCC51)
+	binary.LittleEndian.PutUint16(cc51[6:], 40)
+	binary.LittleEndian.PutUint16(cc51[8:], 0xffff)
+	wantCC51 := "packet_len=52 cc51_magic=true command=0x1002 declared_payload_len=40 direction_status=0xffff classification=CC51 packet"
+	if got := classifyDiscoveryPacket(cc51); got != wantCC51 {
+		t.Fatalf("classify CC51 response = %q, want %q", got, wantCC51)
+	}
+
+	shortCC51 := make([]byte, 44)
+	copy(shortCC51, magicCC51)
+	binary.LittleEndian.PutUint16(shortCC51[4:], 0x0f02)
+	binary.LittleEndian.PutUint16(shortCC51[6:], 32)
+	binary.LittleEndian.PutUint16(shortCC51[8:], 0xffff)
+	wantShortCC51 := "packet_len=44 cc51_magic=true command=0x0f02 declared_payload_len=32 direction_status=0xffff classification=CC51-like short packet"
+	if got := classifyDiscoveryPacket(shortCC51); got != wantShortCC51 {
+		t.Fatalf("classify short CC51-like packet = %q, want %q", got, wantShortCC51)
+	}
+
+	iotc := make([]byte, 44)
+	binary.LittleEndian.PutUint16(iotc[8:], cmdDiscoRes)
+	iotc = tutk.TransCodeBlob(iotc)
+	if got := classifyDiscoveryPacket(iotc); got != "packet_len=44 cc51_magic=false classification=IOTC command=0x0602" {
+		t.Fatalf("classify IOTC response = %q", got)
+	}
+
+	if got := classifyDiscoveryPacket([]byte{0x01, 0x02}); got != "packet_len=2 cc51_magic=false classification=unrecognized" {
+		t.Fatalf("classify unknown packet = %q", got)
+	}
+}
+
+func TestFormatDiscoveryPacketCounts(t *testing.T) {
+	counts := make(map[string]int)
+	recordDiscoveryPacket(&counts, "CC51 short command=0x0f02")
+	recordDiscoveryPacket(&counts, "CC51 short command=0x0f02")
+	recordDiscoveryPacket(&counts, "IOTC command=0x0602")
+	got := formatDiscoveryPacketCounts(counts)
+	want := "CC51 short command=0x0f02 x2; IOTC command=0x0602 x1"
+	if got != want {
+		t.Fatalf("formatDiscoveryPacketCounts() = %q, want %q", got, want)
+	}
+	for i := 0; i < 10; i++ {
+		recordDiscoveryPacket(&counts, string(rune('a'+i)))
+	}
+	if len(counts) > 9 || counts["other packet classes"] == 0 {
+		t.Fatalf("packet class aggregation is not bounded: %v", counts)
+	}
+}

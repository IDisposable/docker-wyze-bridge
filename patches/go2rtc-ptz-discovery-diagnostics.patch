+func classifyDiscoveryPacket(packet []byte) string {
+	if len(packet) >= 2 && string(packet[:2]) == magicCC51 {
+		if len(packet) >= 6 {
+			if len(packet) < packetSizeCC51 {
+				return fmt.Sprintf("CC51-like short packet command=0x%04x", binary.LittleEndian.Uint16(packet[4:]))
+			}
+			return fmt.Sprintf("CC51 command=0x%04x", binary.LittleEndian.Uint16(packet[4:]))
+		}
+		return "unrecognized"
+	}
+
+	decoded := tutk.ReverseTransCodeBlob(packet)
+	if len(decoded) >= 16 {
+		return fmt.Sprintf("IOTC command=0x%04x", binary.LittleEndian.Uint16(decoded[8:]))
+	}
+	return "unrecognized"
+}

--- /dev/null
+++ b/pkg/tutk/dtls/discovery_diagnostics_test.go
@@ -0,0 +1,39 @@
+package dtls
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/tutk"
+)
+
+func TestClassifyDiscoveryPacket(t *testing.T) {
+	cc51 := make([]byte, packetSizeCC51)
+	copy(cc51, magicCC51)
+	binary.LittleEndian.PutUint16(cc51[4:], cmdDiscoCC51)
+	wantCC51 := "packet_len=52 cc51_magic=true command=0x1002 declared_payload_len=0 direction_status=0x0000 classification=CC51 packet"
+	if got := classifyDiscoveryPacket(cc51); got != wantCC51 {
+		t.Fatalf("classify CC51 response = %q, want %q", got, wantCC51)
+	}
+
+	shortCC51 := make([]byte, 44)
+	copy(shortCC51, magicCC51)
+	binary.LittleEndian.PutUint16(shortCC51[4:], 0x0f02)
+	binary.LittleEndian.PutUint16(shortCC51[6:], 36)
+	binary.LittleEndian.PutUint16(shortCC51[8:], 0x0001)
+	wantShortCC51 := "packet_len=44 cc51_magic=true command=0x0f02 declared_payload_len=36 direction_status=0x0001 classification=CC51-like short packet"
+	if got := classifyDiscoveryPacket(shortCC51); got != wantShortCC51 {
+		t.Fatalf("classify short CC51-like packet = %q, want %q", got, wantShortCC51)
+	}
+
+	iotc := make([]byte, 44)
+	binary.LittleEndian.PutUint16(iotc[8:], cmdDiscoRes)
+	iotc = tutk.TransCodeBlob(iotc)
+	if got := classifyDiscoveryPacket(iotc); got != "packet_len=44 cc51_magic=false classification=IOTC command=0x0602" {
+		t.Fatalf("classify IOTC response = %q", got)
+	}
+
+	if got := classifyDiscoveryPacket([]byte{0x01, 0x02}); got != "packet_len=2 cc51_magic=false classification=unrecognized" {
+		t.Fatalf("classify unknown packet = %q", got)
+	}
+}

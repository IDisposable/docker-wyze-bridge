diff --git a/pkg/tutk/dtls/discovery_diagnostics_test.go b/pkg/tutk/dtls/discovery_diagnostics_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/tutk/dtls/discovery_diagnostics_test.go
@@ -0,0 +1,35 @@
+package dtls
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/tutk"
+)
+
+func TestClassifyDiscoveryPacket(t *testing.T) {
+	cc51 := make([]byte, packetSizeCC51)
+	copy(cc51, magicCC51)
+	binary.LittleEndian.PutUint16(cc51[4:], cmdDiscoCC51)
+	if got := classifyDiscoveryPacket(cc51); got != "CC51 command=0x1002" {
+		t.Fatalf("classify CC51 response = %q", got)
+	}
+
+	shortCC51 := make([]byte, 44)
+	copy(shortCC51, magicCC51)
+	binary.LittleEndian.PutUint16(shortCC51[4:], 0x0f02)
+	if got := classifyDiscoveryPacket(shortCC51); got != "CC51-like short packet command=0x0f02" {
+		t.Fatalf("classify short CC51-like packet = %q", got)
+	}
+
+	iotc := make([]byte, 44)
+	binary.LittleEndian.PutUint16(iotc[8:], cmdDiscoRes)
+	iotc = tutk.TransCodeBlob(iotc)
+	if got := classifyDiscoveryPacket(iotc); got != "IOTC command=0x0602" {
+		t.Fatalf("classify IOTC response = %q", got)
+	}
+
+	if got := classifyDiscoveryPacket([]byte{0x01, 0x02}); got != "unrecognized" {
+		t.Fatalf("classify unknown packet = %q", got)
+	}
+}

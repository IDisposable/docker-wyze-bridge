+func TestDeleteStopRejectsRetainedStream(t *testing.T) {
+	var dials atomic.Int32
+	HandleFunc("delete-stop-probe", func(string) (core.Producer, error) { dials.Add(1); return newDeleteStopProducer(), nil })
+	t.Cleanup(func() { delete(handlers, "delete-stop-probe") })
+	stream := NewStream("delete-stop-probe:closed")
+	name := setupDeleteStopTest(t, stream)
+	if status := requestDeleteStop(name, true); status != http.StatusOK {
+		t.Fatalf("DELETE status=%d", status)
+	}
+	if err := stream.AddConsumer(newDeleteStopConsumer()); err == nil {
+		t.Fatal("retained deleted stream accepted a consumer")
+	}
+	if dials.Load() != 0 {
+		t.Fatal("deleted stream started a producer")
+	}
+}

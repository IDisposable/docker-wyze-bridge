+		// Keep delayed authenticated video available for RTP ordering.
+		// Replay protection stays enabled; duplicates are still rejected.
+		s.SetSRTPReplayProtectionWindow(window)
+	}
 
 	// fix https://github.com/pion/webrtc/pull/2407
 	s.SetDTLSInsecureSkipHelloVerify(true)

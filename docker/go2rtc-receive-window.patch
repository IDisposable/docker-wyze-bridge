+)
+
+type deleteStopProducer struct {
+	core.Connection
+	stopped atomic.Int32
+	once    sync.Once
+	done    chan struct{}
+}
+
+func newDeleteStopProducer() *deleteStopProducer {
+	codec := &core.Codec{Name: core.CodecH264, ClockRate: 90000}
+	media := &core.Media{Kind: core.KindVideo, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{codec}}
+	return &deleteStopProducer{Connection: core.Connection{Medias: []*core.Media{media}, Receivers: []*core.Receiver{core.NewReceiver(media, codec)}}, done: make(chan struct{})}
+}
+func (p *deleteStopProducer) Start() error { <-p.done; return nil }
+func (p *deleteStopProducer) Stop() error {
+	p.stopped.Add(1)
+	p.once.Do(func() { p.Connection.Stop(); close(p.done) })
+	return nil
+}
+
+type deleteStopConsumer struct {
+	core.Connection
+	stopped atomic.Int32
+	mu      sync.Mutex
+	once    sync.Once
+	onStop  func()
+}
+
+func newDeleteStopConsumer() *deleteStopConsumer {
+	return &deleteStopConsumer{Connection: core.Connection{Medias: []*core.Media{{Kind: core.KindVideo, Direction: core.DirectionSendonly, Codecs: []*core.Codec{{Name: core.CodecH264, ClockRate: 90000}}}}}}
+}
+func (c *deleteStopConsumer) AddTrack(media *core.Media, codec *core.Codec, track *core.Receiver) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.Senders = append(c.Senders, core.NewSender(media, codec).WithParent(track))
+	return nil
+}
+func (c *deleteStopConsumer) Stop() error {
+	c.stopped.Add(1)
+	c.once.Do(func() {
+		if c.onStop != nil {
+			c.onStop()
+		}
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		c.Connection.Stop()
+	})
+	return nil
+}
+
+func setupDeleteStopTest(t *testing.T, stream *Stream) string {
+	t.Helper()
+	name := "delete-stop-test"
+	oldConfig := app.ConfigPath
+	app.ConfigPath = t.TempDir() + "/go2rtc.yaml"
+	if err := os.WriteFile(app.ConfigPath, []byte("streams:\n  delete-stop-test: []\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	streamsMu.Lock()
+	streams[name] = stream
+	streamsMu.Unlock()
+	t.Cleanup(func() {
+		for _, consumer := range stream.consumers {
+			consumer.Stop()
+		}
+		for _, producer := range stream.producers {
+			producer.stop()
+		}
+		Delete(name)
+		app.ConfigPath = oldConfig
+	})
+	return name
+}
+
+func requestDeleteStop(name string, stop bool, sources ...string) int {
+	query := url.Values{"src": []string{name}}
+	if stop {
+		query.Set("stop", "1")
+	}
+	for _, source := range sources {
+		query.Add("if_src", source)
+	}
+	url := "/api/streams?" + query.Encode()
+	w := httptest.NewRecorder()
+	apiStreams(w, httptest.NewRequest(http.MethodDelete, url, nil))
+	return w.Code
+}
+
+func TestDeleteStopOwnedResources(t *testing.T) {
+	producer, consumer := newDeleteStopProducer(), newDeleteStopConsumer()
+	stream := NewStream("delete-stop-probe:active")
+	stream.producers[0].conn = producer
+	stream.producers[0].state = stateTracks
+	stream.consumers = []core.Consumer{consumer}
+	name := setupDeleteStopTest(t, stream)
+	consumer.onStop = func() {
+		if !stream.mu.TryLock() {
+			t.Error("consumer closed while stream lock was held")
+			return
+		}
+		stream.mu.Unlock()
+	}
+	if status := requestDeleteStop(name, true, "delete-stop-probe:wrong", "delete-stop-probe:active"); status != http.StatusOK {
+		t.Fatalf("DELETE status=%d", status)
+	}
+	if Get(name) != nil {
+		t.Fatal("deleted stream still registered")
+	}
+	if producer.stopped.Load() != 1 || consumer.stopped.Load() != 1 {
+		t.Fatalf("owned resources not stopped: producer=%d, consumer=%d", producer.stopped.Load(), consumer.stopped.Load())
+	}
+	if stream.producers[0].conn != nil {
+		t.Fatal("deleted stream retains producer connection")
+	}
+}
+

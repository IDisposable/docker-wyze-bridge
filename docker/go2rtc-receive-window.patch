index 0000000..ea0036c
--- /dev/null
+++ b/pkg/webrtc/receive_window_test.go
@@ -0,0 +1,113 @@
+package webrtc
+
+import (
+	"github.com/pion/rtp"
+	pion "github.com/pion/webrtc/v4"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestReceiveDelayedAuthenticatedPacket(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		factory  func() (*pion.API, error)
+		expected []uint16
+	}{
+		{"default", NewAPI, []uint16{1, 100}},
+		{"delayed-video", func() (*pion.API, error) { return NewReceiveAPI(4096) }, []uint16{1, 100, 2}},
+	} {
+		t.Run(tc.name, func(t *testing.T) { testReceiveWindow(t, tc.factory, tc.expected) })
+	}
+}
+
+func testReceiveWindow(t *testing.T, factory func() (*pion.API, error), expected []uint16) {
+	t.Helper()
+	api, err := factory()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sender, err := api.NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sender.Close()
+	receiver, err := api.NewPeerConnection(pion.Configuration{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer receiver.Close()
+	got := make(chan uint16, 4)
+	receiver.OnTrack(func(track *pion.TrackRemote, _ *pion.RTPReceiver) {
+		for {
+			p, _, e := track.ReadRTP()
+			if e != nil {
+				return
+			}
+			got <- p.SequenceNumber
+		}
+	})
+	connected := make(chan struct{})
+	var once sync.Once
+	sender.OnConnectionStateChange(func(s pion.PeerConnectionState) {
+		if s == pion.PeerConnectionStateConnected {
+			once.Do(func() { close(connected) })
+		}
+	})
+	track, err := pion.NewTrackLocalStaticRTP(pion.RTPCodecCapability{MimeType: pion.MimeTypeH265}, "video", "late-packet-test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = sender.AddTrack(track); err != nil {
+		t.Fatal(err)
+	}
+	offer, err := sender.CreateOffer(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := pion.GatheringCompletePromise(sender)
+	if err = sender.SetLocalDescription(offer); err != nil {
+		t.Fatal(err)
+	}
+	<-done
+	if err = receiver.SetRemoteDescription(*sender.LocalDescription()); err != nil {
+		t.Fatal(err)
+	}
+	answer, err := receiver.CreateAnswer(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	done = pion.GatheringCompletePromise(receiver)
+	if err = receiver.SetLocalDescription(answer); err != nil {
+		t.Fatal(err)
+	}
+	<-done
+	if err = sender.SetRemoteDescription(*receiver.LocalDescription()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-connected:
+	case <-time.After(10 * time.Second):
+		t.Fatal("local peers did not connect")
+	}
+	for _, seq := range []uint16{1, 100, 2, 1} {
+		if err = track.WriteRTP(&rtp.Packet{Header: rtp.Header{Version: 2, SequenceNumber: seq, Timestamp: 90000}, Payload: []byte{2, 1, 7}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, want := range expected {
+		select {
+		case seq := <-got:
+			if seq != want {
+				t.Fatalf("got sequence %d, want %d", seq, want)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatalf("valid delayed sequence %d was lost", want)
+		}
+	}
+	select {
+	case seq := <-got:
+		t.Fatalf("replay accepted: sequence %d", seq)
+	case <-time.After(100 * time.Millisecond):
+	}
+}

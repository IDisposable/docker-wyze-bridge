+// close is an explicit teardown, rather than the default map-only deletion.
+// Retained or pending clients cannot keep producers alive after teardown.
+func (s *Stream) close() {
+	s.closeOnce.Do(func() {
+		s.mu.Lock()
+		s.closed = true
+		s.mu.Unlock()
+		// Finish any in-flight track attachment before closing its graph.
+		// The owner cancels upstream negotiations before requesting teardown.
+		s.pendingWG.Wait()
+		s.mu.Lock()
+		consumers := append([]core.Consumer(nil), s.consumers...)
+		producers := append([]*Producer(nil), s.producers...)
+		s.consumers = nil
+		s.mu.Unlock()
+		// Stop may call back into this stream; do not hold its mutex.
+		for _, consumer := range consumers {
+			_ = consumer.Stop()
+		}
+		for _, producer := range producers {
+			producer.stopWithForce(true)
+		}
+	})
+}

+func TestDeleteStopOwnershipGuard(t *testing.T) {
+	for _, sources := range []any{"rtsp://operator.test/feed", []string{"delete-stop-probe:owned", "rtsp://operator.test/feed"}} {
+		stream := NewStream(sources)
+		producer, consumer := newDeleteStopProducer(), newDeleteStopConsumer()
+		stream.producers[0].conn = producer
+		stream.producers[0].state = stateTracks
+		stream.consumers = []core.Consumer{consumer}
+		name := setupDeleteStopTest(t, stream)
+		before, err := os.ReadFile(app.ConfigPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if status := requestDeleteStop(name, true, "delete-stop-probe:owned"); status != http.StatusConflict {
+			t.Fatalf("source mismatch status=%d, want409", status)
+		}
+		if Get(name) != stream {
+			t.Fatal("ownership mismatch removed an operator stream")
+		}
+		if producer.stopped.Load() != 0 || consumer.stopped.Load() != 0 {
+			t.Fatal("ownership mismatch stopped operator resources")
+		}
+		after, err := os.ReadFile(app.ConfigPath)
+		if err != nil || !bytes.Equal(before, after) {
+			t.Fatal("ownership mismatch changed saved configuration")
+		}
+	}
+}

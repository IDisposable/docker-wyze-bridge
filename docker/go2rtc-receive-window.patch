+func TestDeleteStopPendingDialCannotReviveStream(t *testing.T) {
+	dialStarted := make(chan struct{})
+	releaseDial := make(chan struct{})
+	var releaseOnce sync.Once
+	release := func() { releaseOnce.Do(func() { close(releaseDial) }) }
+	defer release()
+	producer := newDeleteStopProducer()
+	HandleFunc("delete-stop-probe", func(string) (core.Producer, error) { close(dialStarted); <-releaseDial; return producer, nil })
+	t.Cleanup(func() { delete(handlers, "delete-stop-probe") })
+	stream := NewStream("delete-stop-probe:pending")
+	existingConsumer := newDeleteStopConsumer()
+	stream.consumers = []core.Consumer{existingConsumer}
+	name := setupDeleteStopTest(t, stream)
+	added := make(chan error, 1)
+	go func() { added <- stream.AddConsumer(newDeleteStopConsumer()) }()
+	select {
+	case <-dialStarted:
+	case <-time.After(time.Second):
+		t.Fatal("producer dial did not start")
+	}
+	deleted := make(chan int, 1)
+	go func() { deleted <- requestDeleteStop(name, true) }()
+	deadline := time.Now().Add(time.Second)
+	for {
+		err := stream.AddConsumer(&deleteStopConsumer{})
+		if err != nil && strings.Contains(err.Error(), "stream closed") {
+			break
+		}
+		select {
+		case status := <-deleted:
+			release()
+			<-added
+			t.Fatalf("DELETE finished without tombstoning the stream, status=%d", status)
+		default:
+		}
+		if time.Now().After(deadline) {
+			release()
+			<-added
+			t.Fatal("DELETE did not begin teardown")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	release()
+	select {
+	case err := <-added:
+		if err == nil {
+			t.Fatal("pending consumer attached after teardown began")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("pending consumer did not finish")
+	}
+	select {
+	case status := <-deleted:
+		if status != http.StatusOK {
+			t.Fatalf("DELETE status=%d", status)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("DELETE did not finish")
+	}
+	if producer.stopped.Load() == 0 {
+		t.Fatal("late producer connection was not stopped")
+	}
+	stream.producers[0].mu.Lock()
+	leaked := stream.producers[0].conn != nil || stream.producers[0].state != stateNone
+	stream.producers[0].mu.Unlock()
+	if leaked || stream.pending.Load() != 0 {
+		t.Fatal("pending dial left an active producer")
+	}
+}

+	}
+}
+
+func TestDeleteStopClosesExternalProducer(t *testing.T) {
+	stream := NewStream(nil)
+	producer := newDeleteStopProducer()
+	stream.AddProducer(producer)
+	name := setupDeleteStopTest(t, stream)
+	if status := requestDeleteStop(name, true); status != http.StatusOK {
+		t.Fatalf("DELETE status=%d", status)
+	}
+	if producer.stopped.Load() != 1 {
+		t.Fatal("explicit teardown did not close a pushed producer")
+	}
+	late := newDeleteStopProducer()
+	stream.AddProducer(late)
+	if late.stopped.Load() != 1 || len(stream.producers) != 1 {
+		t.Fatal("deleted stream accepted a late publisher")
+	}
+}
+
+func TestDeleteStopPreservesConcurrentReplacement(t *testing.T) {
+	HandleFunc("delete-stop-probe", func(string) (core.Producer, error) { return newDeleteStopProducer(), nil })
+	t.Cleanup(func() { delete(handlers, "delete-stop-probe") })
+	stream := NewStream("delete-stop-probe:owned")
+	consumer := newDeleteStopConsumer()
+	stream.consumers = []core.Consumer{consumer}
+	name := setupDeleteStopTest(t, stream)
+	stopping, released := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	release := func() { releaseOnce.Do(func() { close(released) }) }
+	defer release()
+	consumer.onStop = func() { close(stopping); <-released }
+	deleted := make(chan int, 1)
+	go func() { deleted <- requestDeleteStop(name, true, "delete-stop-probe:owned") }()
+	select {
+	case <-stopping:
+	case <-time.After(time.Second):
+		t.Fatal("old stream did not begin teardown")
+	}
+	query := url.Values{"name": []string{name}, "src": []string{"delete-stop-probe:operator-replacement"}}
+	w := httptest.NewRecorder()
+	apiStreams(w, httptest.NewRequest(http.MethodPut, "/api/streams?"+query.Encode(), nil))
+	replacement := Get(name)
+	release()
+	select {
+	case status := <-deleted:
+		if status != http.StatusOK {
+			t.Fatalf("DELETE status=%d", status)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("old teardown did not finish")
+	}
+	if w.Code != http.StatusOK {
+		t.Fatalf("replacement PUT status=%d", w.Code)
+	}
+	if replacement == nil || Get(name) != replacement {
+		t.Fatal("old teardown removed the replacement stream")
+	}
+	saved, err := os.ReadFile(app.ConfigPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(saved), "delete-stop-probe:operator-replacement") {
+		t.Fatalf("old teardown erased replacement configuration: %s", saved)
+	}
+}
+
+func TestDeleteStopCleansResourcesAfterConfigFailure(t *testing.T) {
+	producer, consumer := newDeleteStopProducer(), newDeleteStopConsumer()
+	stream := NewStream("delete-stop-probe:owned")
+	stream.producers[0].conn = producer
+	stream.producers[0].state = stateTracks
+	stream.consumers = []core.Consumer{consumer}
+	name := setupDeleteStopTest(t, stream)
+	path := app.ConfigPath
+	app.ConfigPath = ""
+	status := requestDeleteStop(name, true, "delete-stop-probe:owned")
+	app.ConfigPath = path
+	if status != http.StatusBadRequest {
+		t.Fatalf("config failure status=%d", status)
+	}
+	if Get(name) != nil || producer.stopped.Load() != 1 || consumer.stopped.Load() != 1 {
+		t.Fatal("config failure skipped resource teardown")
+	}
+}
